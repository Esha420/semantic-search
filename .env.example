# Document Intelligence RAG API - Environment Configuration

# Core App Settings
ENVIRONMENT=development
APP_NAME="Document Intelligence RAG API"
API_V1_PREFIX=/api/v1
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Settings (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=document_intelligence
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/document_intelligence
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/document_intelligence

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY=false

# LLM Configuration (NVIDIA NIM)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Embedding Configuration (NVIDIA NIM)
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSIONS=2048

# Retrieval & Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K_RETRIEVAL=5
HYBRID_ALPHA=0.65
RRF_K=60
RERANKING_ENABLED=true
ABSTENTION_THRESHOLD=0.35

# Security & Tenant Scoping
API_KEY_AUTH_ENABLED=false
APP_API_KEY=verisk-doc-intel-secret-key-2026
DEFAULT_TENANT_ID=tenant_default
